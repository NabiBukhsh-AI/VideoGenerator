# Copy to .env and fill in the keys you need:  cp .env.example .env
#
# .env is gitignored. Never commit real keys.
# If a key has ever been committed anywhere, rotate it - it is compromised.

# ---- Credentials ------------------------------------------------------------
# Needed for: script generation (openai), images (openai), narration (openai tts),
# and Whisper caption alignment.
OPENAI_API_KEY=

# Optional alternative for script generation.
ANTHROPIC_API_KEY=

# Optional, for higher-quality narration voices.
ELEVENLABS_API_KEY=

# ---- Provider selection -----------------------------------------------------
# llm:   openai | anthropic | echo         (echo = offline stub, no cost)
# image: openai | placeholder              (placeholder = offline stub)
# tts:   elevenlabs | openai | silent      (silent = offline stub)
VIDEOGEN_LLM_PROVIDER=openai
VIDEOGEN_IMAGE_PROVIDER=openai
VIDEOGEN_TTS_PROVIDER=elevenlabs

# ---- Models -----------------------------------------------------------------
VIDEOGEN_OPENAI_MODEL=gpt-4.1
VIDEOGEN_ANTHROPIC_MODEL=claude-sonnet-4-5
VIDEOGEN_IMAGE_MODEL=gpt-image-1
VIDEOGEN_OPENAI_TTS_MODEL=gpt-4o-mini-tts
VIDEOGEN_OPENAI_TTS_VOICE=alloy
VIDEOGEN_ELEVENLABS_MODEL=eleven_multilingual_v2
VIDEOGEN_ELEVENLABS_VOICE=Rachel

# ---- Generation -------------------------------------------------------------
VIDEOGEN_MAX_SCENES=6
VIDEOGEN_MIN_SCENES=3
VIDEOGEN_MAX_SOURCE_WORDS=6000
VIDEOGEN_TEMPERATURE=0.7
VIDEOGEN_IMAGE_STYLE=cinematic photography, dramatic lighting, high detail

# ---- Execution --------------------------------------------------------------
VIDEOGEN_OUTPUT_DIR=output
VIDEOGEN_MAX_WORKERS=4
VIDEOGEN_CACHE_ENABLED=true
VIDEOGEN_LOG_LEVEL=INFO

# Caption timing: heuristic (free) or whisper (one extra API call per scene).
VIDEOGEN_ALIGNER=heuristic

# Optional: a .ttf for captions. Auto-detected from system fonts when unset.
# VIDEOGEN_FONT_PATH=C:\Windows\Fonts\segoeuib.ttf

# Optional: if ffmpeg is not on PATH.
# VIDEOGEN_FFMPEG_BINARY=C:\ffmpeg\bin\ffmpeg.exe
# VIDEOGEN_FFPROBE_BINARY=C:\ffmpeg\bin\ffprobe.exe
